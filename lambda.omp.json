{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "template": "\uf52f {{.Code}} ",
                    "foreground": "#ff8080",
                    "type": "status",
                    "style": "plain"
                },
                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "template": "λ",
                    "foreground": "#4b5f6a",
                    "type": "text",
                    "style": "plain"
                },
                {
                    "properties": {
                        "cache_duration": "none",
                        "style": "folder"
                    },
                    "template": " {{ .Path }}",
                    "foreground": "#4b5f6a",
                    "type": "path",
                    "style": "plain"
                },
                {
                    "properties":
                    {
                        "branch_icon": "",
                        "cache_duration": "none"
                    },
                    "template": ". λ git:(</>{{ .HEAD }})</>",
                    "foreground": "#4b5f6a",
                    "type": "git",
                    "style": "plain"
                },
                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "template": ".",
                    "foreground": "#4b5f6a",
                    "type": "text",
                    "style": "plain"
                }
            ]
        }
    ],
    "version": 3,
    "final_space": true
}
